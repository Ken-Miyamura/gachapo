{
  "expo": {
    "name": "ガチャポ",
    "slug": "gachapo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gachapo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0A3E"
    },
    "ios": {
      "bundleIdentifier": "com.kenmiyamura.gachapo",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.kenmiyamura.gachapo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1A0A3E",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
